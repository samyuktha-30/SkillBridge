@model SkillBridge.Services.MockDataService
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "AI Learning Plan";
    var target = User.FindFirst("target_role")?.Value ?? "Software Developer";
    var resources = new[]
    {
        ("Machine Learning Crash Course", "Video • 1.5 hrs", "book-open"),
        ("ML Concepts Notes", "PDF • 2.3 MB", "file-text"),
        ("Python Practice Problems", "Practice • 20 questions", "code-xml")
    };
}

<div class="space-y-5">
    <!-- Header -->
    <section class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="page-title">AI Learning Plan</h1>
            <p class="mt-1 text-[13px] text-muted">Your personalized learning roadmap to bridge skill gaps and achieve your career goals.</p>
        </div>
        <div class="flex items-center gap-4 rounded-xl border border-[#c9dcf3] bg-sky px-5 py-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white/60 text-[#2c5480]"><svg class="h-[18px] w-[18px]"><use href="#i-target" /></svg></span>
            <div class="leading-tight">
                <p class="text-[10.5px] text-[#4a6a8f]">Target Role</p>
                <p class="text-[13px] font-semibold text-ink">@target</p>
            </div>
            <a href="/employee/skills" class="ml-4 inline-flex items-center gap-1 text-[11.5px] font-medium text-ink-2 hover:text-brand-deep">Change <svg class="h-3.5 w-3.5"><use href="#i-arrow-right" /></svg></a>
        </div>
    </section>

    <!-- Summary tiles -->
    <section class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-xl border border-[#cfe7da] bg-brand-soft/70 px-5 py-4 text-center">
            <p class="text-[12px] text-ink-2/80">Plan Progress</p>
            <p class="mt-1.5 text-[24px] font-bold leading-none">72%</p>
            <p class="mt-2 inline-flex items-center gap-1.5 text-[11px] text-ink-2"><span class="h-1.5 w-1.5 rounded-full bg-brand-deep"></span> On track</p>
        </div>
        <div class="flex items-center justify-center gap-4 rounded-xl border border-[#cfe7da] bg-brand-soft/70 px-5 py-4">
            <svg class="h-9 w-9 shrink-0 text-ink-2/80"><use href="#i-book-open" /></svg>
            <div class="leading-tight">
                <p class="text-[12px] text-ink-2/80">Topics to Complete</p>
                <p class="mt-1 text-[22px] font-bold leading-none">6 / 10</p>
                <div class="mt-2 h-1.5 w-24 overflow-hidden rounded-full bg-white/70"><div class="h-full w-0 rounded-full bg-brand" data-progress="60"></div></div>
            </div>
        </div>
        <div class="flex items-center justify-center gap-4 rounded-xl border border-[#cfe7da] bg-brand-soft/70 px-5 py-4">
            <svg class="h-9 w-9 shrink-0 text-ink-2/80"><use href="#i-clock" /></svg>
            <div class="leading-tight">
                <p class="text-[12px] text-ink-2/80">Timeline</p>
                <p class="mt-1 text-[20px] font-bold leading-none">2 Weeks</p>
                <p class="mt-1 text-[11px] text-muted">Left</p>
            </div>
        </div>
        <div class="flex items-center justify-center gap-4 rounded-xl border border-[#cfe7da] bg-brand-soft/70 px-5 py-4">
            <svg class="h-9 w-9 shrink-0 text-ink-2/80"><use href="#i-target" /></svg>
            <div class="leading-tight">
                <p class="text-[12px] text-ink-2/80">Goal</p>
                <p class="mt-1 text-[14px] font-bold leading-tight">Be Interview Ready</p>
                <p class="mt-0.5 text-[11px] text-muted">for Dream Job</p>
            </div>
        </div>
    </section>

    <!-- Roadmap + resources -->
    <section class="grid grid-cols-1 gap-4 xl:grid-cols-[1.5fr_1fr]">
        <div class="card p-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <h2 class="section-title flex items-center gap-2"><svg class="h-4 w-4 text-brand-deep"><use href="#i-book-open" /></svg> Your Learning Roadmap</h2>
                <div class="flex gap-1.5">
                    <button type="button" class="btn btn-primary btn-sm">Roadmap</button>
                    <button type="button" class="btn btn-outline btn-sm">List View</button>
                </div>
            </div>

            <ol class="mt-3">
                @foreach (var (module, index) in Model.Roadmap.Select((m, i) => (m, i)))
                {
                    var isDone = module.State == "Completed";
                    var isCurrent = module.State == "In Progress";
                    var action = isDone ? "Review" : isCurrent ? "Continue" : "Start";
                    var statusBadge = module.State switch
                    {
                        "Completed" => "badge-green",
                        "In Progress" => "badge-blue",
                        _ => "badge-muted"
                    };
                    <li class="relative flex flex-wrap items-center gap-3 border-b border-line-soft px-2 py-2.5 last:border-b-0 @(isCurrent ? "rounded-lg border-b-0 bg-sky/70" : "")">
                        @if (index < Model.Roadmap.Count - 1)
                        {
                            <span class="absolute bottom-[-10px] left-[23px] top-0 w-px bg-line" aria-hidden="true"></span>
                        }
                        <span class="relative z-10 flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-[11px] font-semibold
                            @(isDone ? "bg-brand text-white" : isCurrent ? "bg-brand text-white" : "border border-line bg-white text-muted")">
                            @if (isDone)
                            {
                                <svg class="h-4 w-4"><use href="#i-check" /></svg>
                            }
                            else
                            {
                                @(index + 1)
                            }
                        </span>
                        <span class="badge w-28 shrink-0 justify-center @statusBadge">@module.State</span>
                        <div class="min-w-0 flex-1">
                            <p class="truncate text-[13px] font-semibold text-ink">@module.Title</p>
                            <p class="truncate text-[11px] text-muted">@module.Subtitle</p>
                        </div>
                        <span class="inline-flex shrink-0 items-center gap-1.5 text-[11px] text-muted"><svg class="h-3.5 w-3.5"><use href="#i-clock" /></svg> @module.Duration</span>
                        <a href="/employee/skills" class="btn btn-primary btn-sm shrink-0">@action <svg class="h-3.5 w-3.5"><use href="#i-arrow-right" /></svg></a>
                    </li>
                }
            </ol>
        </div>

        <div class="space-y-4">
            <div class="card p-5">
                <h2 class="section-title flex items-center gap-2"><svg class="h-4 w-4 text-brand-deep"><use href="#i-book-marked" /></svg> Recommended Resources</h2>
                <div class="mt-2 divide-y divide-line-soft">
                    @foreach (var (title, meta, icon) in resources)
                    {
                        <a href="/employee/resources" class="flex items-center gap-3 py-3 hover:opacity-80">
                            <span class="flex h-11 w-14 shrink-0 items-center justify-center rounded-md bg-lilac/80 text-[#5a4382]">
                                <svg class="h-5 w-5"><use href="#i-@icon" /></svg>
                            </span>
                            <div class="min-w-0 flex-1">
                                <p class="truncate text-[12.5px] font-semibold text-ink">@title</p>
                                <p class="mt-0.5 truncate text-[10.5px] text-muted">@meta</p>
                            </div>
                            <svg class="h-4 w-4 shrink-0 text-muted"><use href="#i-chevron-right" /></svg>
                        </a>
                    }
                </div>
            </div>

            <div class="rounded-xl border border-[#d9cfee] bg-lilac/80 p-5">
                <h2 class="flex items-center gap-2 text-[14px] font-semibold text-ink"><svg class="h-4 w-4 text-[#5a4382]"><use href="#i-sparkles" /></svg> Ask Your Learning Assistant</h2>
                <p class="mt-1.5 text-[11.5px] leading-relaxed text-ink-2/80">Get help with concepts, doubts and study tips.</p>
                <div class="mt-3 flex items-end justify-between gap-3">
                    <a href="/employee/assistant" class="btn btn-primary btn-sm">Chat Now <svg class="h-3.5 w-3.5"><use href="#i-arrow-right" /></svg></a>
                    <span class="flex h-12 w-12 items-center justify-center rounded-full bg-white/60 text-brand-deep">
                        <svg class="h-7 w-7"><use href="#i-bot" /></svg>
                    </span>
                </div>
            </div>
        </div>
    </section>
</div>
