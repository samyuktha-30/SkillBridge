@model SkillBridge.Services.MockDataService
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "My Progress";
    var performance = new[]
    {
        ("Python", "book-open", 90),
        ("Data Analysis", "trending-up", 80),
        ("Machine Learning", "sparkles", 70),
        ("SQL", "database", 65),
        ("Web Development", "globe", 50)
    };
}

<div class="space-y-5">
    <!-- Header -->
    <section class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="page-title">My Progress</h1>
            <p class="mt-1 text-[13px] text-muted">Track your learning journey and see how you're growing.</p>
        </div>
        <div class="relative flex items-center gap-4 overflow-hidden rounded-xl border border-[#cfe7da] bg-brand-soft px-5 py-3">
            <svg class="pointer-events-none absolute -right-2 -top-2 h-20 w-24 text-brand/25" viewBox="0 0 100 60" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M2 52 L26 34 L46 40 L68 16 L96 4" />
                <path d="M78 4 H96 V22" />
            </svg>
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white/70 text-brand-deep"><svg class="h-[18px] w-[18px]"><use href="#i-chart-no-axes-column" /></svg></span>
            <div class="leading-tight">
                <p class="text-[13px] font-semibold text-ink">Keep going!</p>
                <p class="text-[11px] text-ink-2/80">You're making great progress.</p>
            </div>
        </div>
    </section>

    <!-- Stats -->
    <section class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        @{
            var stats = new (string Label, string Value, string Icon, int Bar)[]
            {
                ("Overall Progress", "72%", "trending-up", 72),
                ("Assessments Completed", "5 / 8", "clipboard-list", 63),
                ("Skills Improved", "4", "target", 50),
                ("Learning Hours", "18.5 hrs", "clock", 74)
            };
        }
        @foreach (var stat in stats)
        {
            <div class="rounded-xl border border-[#cfe7da] bg-brand-soft/70 p-4">
                <div class="flex items-center gap-2.5">
                    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white/70 text-brand-deep"><svg class="h-[18px] w-[18px]"><use href="#i-@stat.Icon" /></svg></span>
                    <p class="text-[12px] text-ink-2/80">@stat.Label</p>
                </div>
                <p class="mt-2 text-[23px] font-bold leading-none">@stat.Value</p>
                <div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-white/70"><div class="h-full w-0 rounded-full bg-brand" data-progress="@stat.Bar"></div></div>
            </div>
        }
    </section>

    <!-- Chart + performance -->
    <section class="grid grid-cols-1 gap-4 xl:grid-cols-[1.35fr_1fr]">
        <div class="card p-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <h2 class="section-title flex items-center gap-2"><svg class="h-4 w-4 text-brand-deep"><use href="#i-trending-up" /></svg> Progress Overview</h2>
                <div class="flex gap-1" data-pill-group="solid">
                    <button type="button" class="rounded-full px-3 py-1 text-[11px] is-active" data-pill>1M</button>
                    <button type="button" class="rounded-full px-3 py-1 text-[11px] font-medium text-ink-2 hover:bg-cream" data-pill>3M</button>
                    <button type="button" class="rounded-full px-3 py-1 text-[11px] font-medium text-ink-2 hover:bg-cream" data-pill>6M</button>
                    <button type="button" class="rounded-full px-3 py-1 text-[11px] font-medium text-ink-2 hover:bg-cream" data-pill>1Y</button>
                </div>
            </div>
            <div class="mt-3 h-[280px] w-full"
                 data-line-chart='{"labels":["Oct 1","Oct 8","Oct 15","Oct 22","Oct 29"],"values":[20,42,55,68,72],"current":true}'></div>
        </div>

        <div class="card p-5">
            <h2 class="section-title flex items-center gap-2"><svg class="h-4 w-4 text-brand-deep"><use href="#i-trending-up" /></svg> Skill-wise Performance</h2>
            <div class="mt-4 space-y-4">
                @foreach (var (name, icon, value) in performance)
                {
                    <div class="flex items-center gap-3">
                        <svg class="h-4 w-4 shrink-0 text-muted"><use href="#i-@icon" /></svg>
                        <span class="w-[130px] shrink-0 text-[12px] text-ink-2">@name</span>
                        <span class="h-2 flex-1 overflow-hidden rounded-full bg-[#e9e4f6]">
                            <span class="block h-full w-0 rounded-full bg-brand" data-progress="@value"></span>
                        </span>
                        <span class="w-8 shrink-0 text-right text-[11.5px] font-medium text-ink-2">@value%</span>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Achievements + activity -->
    <section class="grid grid-cols-1 gap-4 xl:grid-cols-[1.35fr_1fr]">
        <div class="card p-5">
            <div class="flex items-center justify-between">
                <h2 class="section-title flex items-center gap-2"><svg class="h-4 w-4 text-brand-deep"><use href="#i-trophy" /></svg> Your Achievements</h2>
                <a href="/employee/progress" class="inline-flex items-center gap-1 text-[11.5px] font-medium text-ink-2 hover:text-brand-deep">View All <svg class="h-3.5 w-3.5"><use href="#i-arrow-right" /></svg></a>
            </div>
            <div class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-4">
                @foreach (var achievement in Model.Achievements)
                {
                    <div class="text-center">
                        <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-xl bg-brand-soft text-brand-deep">
                            <svg class="h-6 w-6"><use href="#i-@achievement.Icon" /></svg>
                        </span>
                        <p class="mt-2 text-[11px] leading-tight text-ink-2">@achievement.Title</p>
                    </div>
                }
            </div>
        </div>

        <div class="card p-5">
            <div class="flex items-center justify-between">
                <h2 class="section-title flex items-center gap-2"><svg class="h-4 w-4 text-brand-deep"><use href="#i-clock" /></svg> Recent Activity</h2>
                <a href="/employee/progress" class="inline-flex items-center gap-1 text-[11.5px] font-medium text-ink-2 hover:text-brand-deep">View All <svg class="h-3.5 w-3.5"><use href="#i-arrow-right" /></svg></a>
            </div>
            <ul class="mt-4 space-y-4">
                @foreach (var activity in Model.EmployeeActivity)
                {
                    <li class="flex items-start gap-3">
                        <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-brand"></span>
                        <div class="min-w-0 flex-1">
                            <p class="truncate text-[12.5px] text-ink-2"><span class="font-semibold text-ink">@activity.Title</span></p>
                        </div>
                        <span class="shrink-0 text-[10.5px] text-muted">@activity.Time</span>
                    </li>
                }
            </ul>
        </div>
    </section>
</div>
