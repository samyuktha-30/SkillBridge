@{
    ViewData["Title"] = "Create your account";
    var role = Model?.Role as string ?? "Employee";
}

<div class="flex min-h-screen flex-col bg-cream">
    <header class="shrink-0 border-b border-line/70 bg-white">
        <div class="mx-auto flex h-[76px] w-full max-w-[1440px] items-center justify-between px-6 lg:px-10">
            <a href="/" class="flex items-center gap-2.5">
                <svg class="h-[25px] w-[25px] text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                    <path d="M6 12v5c3 3 9 3 12 0v-5" />
                </svg>
                <span class="text-[17px] font-bold tracking-[-0.01em]">SkillBridge AI</span>
            </a>
            <div class="text-[12.5px] text-muted">
                Already have an account?
                <a href="/login" class="ml-1 inline-flex items-center gap-1 font-semibold text-ink hover:text-brand-deep">
                    Sign In <svg class="h-3.5 w-3.5"><use href="#i-arrow-right" /></svg>
                </a>
            </div>
        </div>
    </header>

    <main class="mx-auto grid w-full max-w-[1440px] flex-1 items-center gap-10 px-6 py-9 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14 lg:px-10">
        <section class="hidden lg:block">
            <div class="max-w-[480px]">
                <h1 class="text-[42px] font-bold leading-[1.12] tracking-[-0.03em]">
                    Build Your Skills.<br />
                    Grow Your Career.
                </h1>
                <p class="mt-4 max-w-[420px] text-[14px] leading-relaxed text-muted">
                    Join SkillBridge AI and take the next step towards a more skilled and future-ready you.
                </p>

                <img src="/img/auth-side.png" alt="Laptop with code and books" class="mt-9 w-full max-w-[400px]" draggable="false" />

                <div class="mt-8 grid max-w-[430px] grid-cols-3 divide-x divide-line/80 text-center">
                    <div class="px-2">
                        <svg class="mx-auto h-6 w-6 text-ink-2/70"><use href="#i-target" /></svg>
                        <p class="mt-2 text-[11.5px] leading-tight text-muted">Identify<br />Skill Gaps</p>
                    </div>
                    <div class="px-2">
                        <svg class="mx-auto h-6 w-6 text-ink-2/70"><use href="#i-book-open" /></svg>
                        <p class="mt-2 text-[11.5px] leading-tight text-muted">Get Personalized<br />Learning Plans</p>
                    </div>
                    <div class="px-2">
                        <svg class="mx-auto h-6 w-6 text-ink-2/70"><use href="#i-trophy" /></svg>
                        <p class="mt-2 text-[11.5px] leading-tight text-muted">Track Your<br />Progress</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="flex justify-center lg:justify-end">
            <div class="w-full max-w-[600px] rounded-2xl border border-line bg-white px-7 py-7 shadow-[0_10px_40px_-24px_rgba(13,34,70,0.25)] sm:px-9">
                <h2 class="text-[28px] font-bold leading-tight tracking-[-0.02em]">Create Your Account</h2>
                <p class="mt-1 text-[13px] text-muted">Choose your role to get started</p>

                <form method="post" action="/signup" class="mt-5 space-y-3.5">
                    @Html.AntiForgeryToken()

                    <div class="grid grid-cols-2 gap-3">
                        <label class="group cursor-pointer">
                            <input type="radio" name="role" value="Employee" class="sr-only" @(role != "Manager" ? "checked" : "") />
                            <span class="flex h-full items-center gap-2.5 rounded-lg border border-line px-3.5 py-3 transition group-has-checked:border-[#93b7e0] group-has-checked:bg-sky/60 group-has-checked:ring-1 group-has-checked:ring-[#93b7e0]/40">
                                <svg class="h-[18px] w-[18px] shrink-0 text-ink-2"><use href="#i-graduation-cap" /></svg>
                                <span class="min-w-0 leading-tight">
                                    <span class="block truncate text-[11.5px] font-semibold text-ink">Employee</span>
                                    <span class="block truncate text-[10px] text-muted">(Student / Candidate)</span>
                                </span>
                                <span class="ml-auto flex h-3.5 w-3.5 items-center justify-center rounded-full border border-[#a9b8c9] bg-white">
                                    <span class="hidden h-1.5 w-1.5 rounded-full bg-[#2c5480] group-has-checked:block"></span>
                                </span>
                            </span>
                        </label>
                        <label class="group cursor-pointer">
                            <input type="radio" name="role" value="Manager" class="sr-only" @(role == "Manager" ? "checked" : "") />
                            <span class="flex h-full items-center gap-2.5 rounded-lg border border-line px-3.5 py-3 transition group-has-checked:border-[#93b7e0] group-has-checked:bg-sky/60 group-has-checked:ring-1 group-has-checked:ring-[#93b7e0]/40">
                                <svg class="h-[18px] w-[18px] shrink-0 text-ink-2"><use href="#i-users" /></svg>
                                <span class="min-w-0 leading-tight">
                                    <span class="block truncate text-[11.5px] font-semibold text-ink">Manager / HR</span>
                                    <span class="block truncate text-[10px] text-muted">(Company Admin)</span>
                                </span>
                                <span class="ml-auto flex h-3.5 w-3.5 items-center justify-center rounded-full border border-[#a9b8c9] bg-white">
                                    <span class="hidden h-1.5 w-1.5 rounded-full bg-[#2c5480] group-has-checked:block"></span>
                                </span>
                            </span>
                        </label>
                    </div>

                    <label class="relative block">
                        <svg class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-muted"><use href="#i-user" /></svg>
                        <input type="text" name="fullName" required placeholder="Full Name" class="field pl-10" autocomplete="name" />
                    </label>

                    <label class="relative block">
                        <svg class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-muted"><use href="#i-mail" /></svg>
                        <input type="email" name="email" required placeholder="Email Address" class="field pl-10" autocomplete="email" />
                    </label>

                    <label class="relative block">
                        <svg class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-muted"><use href="#i-lock" /></svg>
                        <input type="password" name="password" required placeholder="Password" class="field pl-10 pr-10" autocomplete="new-password" />
                        <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-muted hover:text-ink" data-password-toggle aria-label="Show password">
                            <svg class="h-4 w-4"><use href="#i-eye-off" /></svg>
                        </button>
                    </label>

                    <label class="relative block">
                        <svg class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-muted"><use href="#i-building-2" /></svg>
                        <input type="text" name="company" placeholder="Company Name" class="field pl-10 pr-20" autocomplete="organization" />
                        <span class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 text-[10.5px] text-muted">(Optional)</span>
                    </label>

                    <button type="submit" class="btn btn-primary mt-1 w-full py-3">
                        Create Account
                        <svg class="h-4 w-4"><use href="#i-arrow-right" /></svg>
                    </button>
                </form>

                <div class="my-4 flex items-center gap-3 text-[11px] uppercase tracking-wide text-muted">
                    <span class="h-px flex-1 bg-line"></span>
                    or
                    <span class="h-px flex-1 bg-line"></span>
                </div>

                <button type="button" class="btn btn-outline w-full py-3">
                    <span class="text-[15px] font-bold leading-none">G</span>
                    Continue with Google
                </button>

                <p class="mt-5 text-center text-[11px] text-muted">
                    By creating an account, you agree to our
                    <a href="#" class="underline decoration-line underline-offset-2 hover:text-ink">Terms of Service</a> and
                    <a href="#" class="underline decoration-line underline-offset-2 hover:text-ink">Privacy Policy</a>.
                </p>
            </div>
        </section>
    </main>
</div>
