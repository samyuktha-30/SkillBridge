@{
    ViewData["Title"] = "Reset your password";
    var sentTo = TempData["ResetSent"] as string;
}

<div class="flex min-h-screen flex-col bg-cream">
    <header class="shrink-0 border-b border-line/70 bg-white">
        <div class="mx-auto flex h-[76px] w-full max-w-[1440px] items-center justify-between px-6 lg:px-10">
            <a href="/" class="flex items-center gap-2.5">
                <svg class="h-[25px] w-[25px] text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                    <path d="M6 12v5c3 3 9 3 12 0v-5" />
                </svg>
                <span class="text-[17px] font-bold tracking-[-0.01em]">SkillBridge AI</span>
            </a>
            <a href="/login" class="inline-flex items-center gap-1.5 text-[12.5px] font-medium text-ink hover:text-brand-deep">
                <svg class="h-4 w-4"><use href="#i-arrow-left" /></svg>
                Back to Login
            </a>
        </div>
    </header>

    <main class="relative mx-auto grid w-full max-w-[1440px] flex-1 items-center gap-10 overflow-hidden px-6 py-10 lg:grid-cols-[0.95fr_1.05fr] lg:gap-14 lg:px-10">
        <div class="pointer-events-none absolute -top-24 left-1/3 h-64 w-64 rounded-full bg-brand-soft/70"></div>
        <div class="pointer-events-none absolute right-0 top-40 h-72 w-72 translate-x-1/3 rounded-full bg-brand-soft/60"></div>

        <section class="relative hidden lg:block">
            <div class="max-w-[460px]">
                <h1 class="text-[46px] font-bold leading-[1.1] tracking-[-0.03em]">
                    Forgot Your<br />Password?
                </h1>
                <p class="mt-5 max-w-[360px] text-[14px] leading-relaxed text-muted">
                    No worries! We'll help you reset it and get back on track.
                </p>

                <img src="/img/reset-side.png" alt="Password reset illustration" class="mt-10 w-full max-w-[330px]" draggable="false" />
            </div>
        </section>

        <section class="relative flex justify-center lg:justify-end">
            <div class="w-full max-w-[560px] rounded-2xl border border-line bg-white px-7 py-8 text-center shadow-[0_10px_40px_-24px_rgba(13,34,70,0.25)] sm:px-10">
                <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-soft text-brand-deep">
                    <svg class="h-7 w-7"><use href="#i-shield-check" /></svg>
                </span>

                <h2 class="mt-4 text-[26px] font-bold tracking-[-0.02em]">Reset Your Password</h2>
                <p class="mx-auto mt-2 max-w-[380px] text-[12.5px] leading-relaxed text-muted">
                    Enter your registered email address and we'll send you a password reset link.
                </p>

                @if (!string.IsNullOrEmpty(sentTo))
                {
                    <div class="mt-5 flex items-start gap-2.5 rounded-lg bg-brand-soft/70 px-4 py-3 text-left text-[12px] text-brand-deep">
                        <svg class="mt-0.5 h-4 w-4 shrink-0"><use href="#i-circle-check" /></svg>
                        <span>If an account exists for <span class="font-semibold">@sentTo</span>, a reset link is on its way. Check your inbox.</span>
                    </div>
                }

                <form method="post" action="/forgot-password" class="mt-6 space-y-4 text-left">
                    @Html.AntiForgeryToken()
                    <label class="relative block">
                        <svg class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-muted"><use href="#i-mail" /></svg>
                        <input type="email" name="email" required placeholder="Email Address" class="field pl-10" autocomplete="email" />
                    </label>
                    <button type="submit" class="btn btn-primary w-full py-3">
                        <svg class="h-4 w-4"><use href="#i-send" /></svg>
                        Send Reset Link
                    </button>
                </form>

                <div class="my-5 flex items-center gap-3 text-[11px] uppercase tracking-wide text-muted">
                    <span class="h-px flex-1 bg-line"></span>
                    or
                    <span class="h-px flex-1 bg-line"></span>
                </div>

                <button type="button" class="btn btn-outline w-full py-3">
                    <span class="text-[15px] font-bold leading-none">G</span>
                    Continue with Google
                </button>

                <a href="/login" class="mt-5 inline-flex items-center gap-1.5 text-[12px] font-medium text-ink-2 hover:text-brand-deep">
                    <svg class="h-4 w-4"><use href="#i-arrow-left" /></svg>
                    Back to Login
                </a>
            </div>
        </section>
    </main>
</div>
