@model ManagerProfileViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "My Profile";
    var isEditing = ViewData["ProfileEditing"] as bool? == true;
    var departments = string.IsNullOrWhiteSpace(Model.ManagedDepartments)
        ? "your assigned departments"
        : Model.ManagedDepartments;
}

<div class="manager-profile">
    <img class="profile-illustration" src="/img/hero.png" alt="" draggable="false" />

    <div class="manager-profile-content">
        <header class="profile-page-heading">
            <div>
                <h1>My Profile</h1>
                <p>Manage your personal information and management responsibilities.</p>
            </div>
        </header>

        <section class="profile-identity">
            <div class="profile-identity-copy">
                <h2>@Model.FullName</h2>
                <p class="profile-identity-role">
                    @Model.JobRole <span aria-hidden="true">·</span> @Model.Department
                </p>
                <p class="profile-identity-description">Manage employee development across @departments.</p>
            </div>
            <button type="button" class="profile-button profile-button-edit @(isEditing ? "hidden" : "")" data-profile-edit>
                Edit profile
            </button>
        </section>

        <div class="profile-layout">
            <section class="profile-card profile-personal-information">
                <h2>Personal information</h2>
                <form asp-controller="Manager" asp-action="Profile" method="post" class="profile-form" data-profile-form>
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="profile-validation" role="alert"></div>
                    }

                    <div class="profile-fields">
                        <label class="profile-field">
                            <span>Full name</span>
                            <input asp-for="FullName" class="profile-input" readonly="@(!isEditing)" required autocomplete="name" data-profile-field />
                            <span asp-validation-for="FullName" class="profile-field-error"></span>
                        </label>
                        <label class="profile-field">
                            <span>Email address</span>
                            <input asp-for="Email" type="email" class="profile-input" readonly="@(!isEditing)" required autocomplete="email" data-profile-field />
                            <span asp-validation-for="Email" class="profile-field-error"></span>
                        </label>
                        <label class="profile-field">
                            <span>Phone number</span>
                            <input asp-for="PhoneNumber" type="tel" class="profile-input" readonly="@(!isEditing)" autocomplete="tel" data-profile-field />
                            <span asp-validation-for="PhoneNumber" class="profile-field-error"></span>
                        </label>
                        <label class="profile-field">
                            <span>Department</span>
                            <input asp-for="Department" class="profile-input" readonly="@(!isEditing)" required data-profile-field />
                            <span asp-validation-for="Department" class="profile-field-error"></span>
                        </label>
                        <label class="profile-field">
                            <span>Job title</span>
                            <input asp-for="JobRole" class="profile-input" readonly="@(!isEditing)" required data-profile-field />
                            <span asp-validation-for="JobRole" class="profile-field-error"></span>
                        </label>
                        <label class="profile-field">
                            <span>Employee ID</span>
                            <input asp-for="EmployeeId" class="profile-input" readonly />
                        </label>
                    </div>

                    <p class="profile-demo-note">Profile changes are demo-only for this signed-in account. They update the sign-in cookie, not a profile database.</p>
                    <div class="profile-form-actions @(isEditing ? "" : "hidden")" data-profile-actions>
                        <button type="button" class="profile-button" data-profile-cancel>Cancel</button>
                        <button type="submit" class="profile-button profile-button-save">Save changes</button>
                    </div>
                </form>
            </section>

            <section class="profile-card profile-management-scope">
                <h2>Management scope</h2>
                <dl>
                    <div>
                        <dt>Managed employees</dt>
                        <dd>@Model.ManagedEmployeeCount</dd>
                    </div>
                    <div>
                        <dt>Departments</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.ManagedDepartments) ? "None assigned" : Model.ManagedDepartments)</dd>
                    </div>
                    <div>
                        <dt>Assessment coverage</dt>
                        <dd>@Model.AssessedEmployeeCount of @Model.ManagedEmployeeCount employees</dd>
                    </div>
                    <div>
                        <dt>Employees with skill gaps</dt>
                        <dd>@Model.EmployeesWithSkillGaps</dd>
                    </div>
                </dl>
            </section>
        </div>

        <div class="profile-layout profile-layout-footer">
            <section class="profile-card profile-responsibilities">
                <h2>Development responsibilities</h2>
                <p>Review assessments, assign learning plans, and monitor team progress.</p>
                <p class="profile-review-note">Review cadence: Not configured <span aria-hidden="true">·</span> Next review: Not scheduled</p>
                <a href="/manager/dashboard" class="profile-button profile-dashboard-link">View team dashboard</a>
            </section>

            <section class="profile-card profile-account-access">
                <h2>Account access</h2>
                <p>@Model.AccountRole access <span aria-hidden="true">·</span> @Model.AccountStatus</p>
                <p>Control sign-in and notification preferences.</p>
                <a href="/manager/settings" class="profile-button profile-settings-link">Open settings</a>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const form = document.querySelector("[data-profile-form]");
            if (!form) return;

            const fields = form.querySelectorAll("[data-profile-field]");
            const editButton = document.querySelector("[data-profile-edit]");
            const actions = form.querySelector("[data-profile-actions]");
            const setEditing = (editing) => {
                fields.forEach((field) => { field.readOnly = !editing; });
                editButton?.classList.toggle("hidden", editing);
                actions?.classList.toggle("hidden", !editing);
            };

            editButton?.addEventListener("click", () => setEditing(true));
            form.querySelector("[data-profile-cancel]")?.addEventListener("click", () => {
                window.location.assign(form.action);
            });
        })();
    </script>
}
