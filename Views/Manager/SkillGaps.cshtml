@model SkillBridge.Services.MockDataService
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Skill Gap Analytics";
    var gapRows = new[]
    {
        ("Alex Morgan", "Java", "2 / 5", "3 / 5", "1 level", "Java Foundations"),
        ("Alex Morgan", "SQL", "2 / 5", "3 / 5", "1 level", "SQL Query Practice"),
        ("Chris Taylor", "Not assessed", "—", "—", "Unknown", "Complete assessment")
    };
    var maxCount = 9.0;
}

<div class="space-y-4">
    <!-- Header -->
    <section class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="page-title">Skill Gap Analytics</h1>
            <p class="mt-1 text-[13px] text-muted">Compare assessed skills with role requirements and prioritize development.</p>
        </div>
        <img src="/img/chart-hero.png" alt="" class="hidden h-[70px] w-auto select-none sm:block" draggable="false" />
    </section>

    <!-- Stats -->
    <section class="grid grid-cols-1 gap-4 md:grid-cols-3">
        <div class="rounded-xl border border-[#c9dcf3] bg-sky p-4">
            <p class="text-[12px] text-ink-2/80">Assessed employees</p>
            <p class="mt-1.5 text-[24px] font-bold leading-none">18 of 24</p>
            <p class="mt-2 text-[11px] text-muted">6 employees not yet assessed</p>
        </div>
        <div class="rounded-xl border border-[#c9dcf3] bg-sky p-4">
            <p class="text-[12px] text-ink-2/80">Employees with skill gaps</p>
            <p class="mt-1.5 text-[24px] font-bold leading-none">12</p>
            <p class="mt-2 text-[11px] text-muted">Of 18 assessed employees</p>
        </div>
        <div class="rounded-xl border border-[#c9dcf3] bg-sky p-4">
            <p class="text-[12px] text-ink-2/80">Meeting role requirements</p>
            <p class="mt-1.5 text-[24px] font-bold leading-none">6</p>
            <p class="mt-2 text-[11px] text-muted">No identified skill gaps</p>
        </div>
    </section>

    <!-- Filters -->
    <section class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
        <button type="button" class="btn btn-outline w-full justify-between !py-2.5 text-[11.5px] text-muted">Department: All <svg class="h-3.5 w-3.5"><use href="#i-chevron-down" /></svg></button>
        <button type="button" class="btn btn-outline w-full justify-between !py-2.5 text-[11.5px] text-muted">Job role: All roles <svg class="h-3.5 w-3.5"><use href="#i-chevron-down" /></svg></button>
        <button type="button" class="btn btn-outline w-full justify-between !py-2.5 text-[11.5px] text-muted">Assessment: Latest <svg class="h-3.5 w-3.5"><use href="#i-chevron-down" /></svg></button>
        <button type="button" class="btn btn-outline w-full justify-between !py-2.5 text-[11.5px] text-muted">Export analysis <svg class="h-3.5 w-3.5"><use href="#i-download" /></svg></button>
    </section>

    <!-- Priority + actions -->
    <section class="grid grid-cols-1 gap-4 xl:grid-cols-2">
        <div class="card p-5">
            <h2 class="text-[15px] font-semibold text-ink">Priority skills · Software Developer</h2>
            <p class="mt-0.5 text-[11px] text-muted">Employees below the required skill level</p>
            <div class="mt-4 space-y-4">
                @foreach (var (skill, count) in Model.PrioritySkills)
                {
                    <div class="flex items-center gap-3">
                        <span class="w-28 shrink-0 text-[11.5px] text-ink-2">@skill</span>
                        <div class="h-2.5 flex-1 overflow-hidden rounded-sm bg-[#f1f6f2]">
                            <div class="h-full rounded-sm bg-brand" style="width:@(Math.Round(count / maxCount * 100))%"></div>
                        </div>
                        <span class="w-5 shrink-0 text-right text-[11px] font-medium text-ink-2">@count</span>
                    </div>
                }
            </div>
            <p class="mt-4 text-[10.5px] text-muted">Counts overlap: an employee can have gaps in multiple skills.</p>
        </div>

        <div class="card p-5">
            <h2 class="section-title">Recommended actions</h2>
            <div class="mt-3 space-y-3">
                <div>
                    <p class="text-[12px] font-semibold text-ink">1. Prioritize Java development</p>
                    <p class="mt-0.5 text-[11px] text-muted">8 employees are below the role requirement.</p>
                </div>
                <div>
                    <p class="text-[12px] font-semibold text-ink">2. Complete remaining assessments</p>
                    <p class="mt-0.5 text-[11px] text-muted">Assess 6 employees before assigning targeted plans.</p>
                </div>
            </div>
            <button type="button" class="btn btn-outline btn-sm mt-4">Review learning plans</button>
        </div>
    </section>

    <!-- Table -->
    <section class="space-y-2">
        <div>
            <h2 class="section-title">Employee skill gaps</h2>
            <p class="mt-0.5 text-[11px] text-muted">Levels use a 1–5 scale · Selected employee: Alex Morgan</p>
        </div>
        <div class="card overflow-hidden">
            <div class="overflow-x-auto">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th class="!bg-sky/70">Employee</th>
                            <th class="!bg-sky/70">Skill</th>
                            <th class="!bg-sky/70">Current level</th>
                            <th class="!bg-sky/70">Required level</th>
                            <th class="!bg-sky/70">Gap</th>
                            <th class="!bg-sky/70">Recommended action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (name, skill, current, required, gap, action) in gapRows)
                        {
                            <tr>
                                <td class="whitespace-nowrap font-medium text-ink">@name</td>
                                <td class="text-muted">@skill</td>
                                <td class="text-muted">@current</td>
                                <td class="text-muted">@required</td>
                                <td class="text-muted">@gap</td>
                                <td class="text-muted">@action</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>
