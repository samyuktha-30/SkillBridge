@model ManagerReportDetail

@{
    Layout = "_AppLayout";
    ViewData["Title"] = $"{Model.Report.Name} - Report Detail";
    var statusBadge = Model.Report.Status == "Ready" ? "badge-green" : "badge-muted";
}

<div class="space-y-5">
    <section class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <a href="/manager/reports" class="inline-flex items-center gap-1.5 text-[11.5px] font-medium text-ink-2 hover:text-brand-deep">
                <svg class="h-3.5 w-3.5"><use href="#i-arrow-left" /></svg>
                Back to Reports
            </a>
            <div class="mt-3">
                <h1 class="page-title">@Model.Report.Name</h1>
                <p class="mt-1 text-[13px] text-muted">@Model.Report.Category <span class="mx-1 text-line">·</span> @Model.Report.Department</p>
            </div>
        </div>
        <img src="/img/reports-hero.png" alt="" class="hidden h-[70px] w-auto select-none sm:block" draggable="false" />
    </section>

    <section class="card p-5">
        <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
                <p class="text-[11px] font-medium uppercase tracking-wide text-muted">Report information</p>
                <h2 class="mt-1 text-[17px] font-semibold text-ink">@Model.Report.Name</h2>
            </div>
            <span class="badge @statusBadge">@Model.Report.Status</span>
        </div>
        <dl class="mt-4 grid grid-cols-1 gap-4 border-t border-line-soft pt-4 sm:grid-cols-2 xl:grid-cols-4">
            <div>
                <dt class="text-[11px] text-muted">Category</dt>
                <dd class="mt-1 text-[13px] font-medium text-ink">@Model.Report.Category</dd>
            </div>
            <div>
                <dt class="text-[11px] text-muted">Generated date</dt>
                <dd class="mt-1 text-[13px] font-medium text-ink">@Model.Report.GeneratedOn</dd>
            </div>
            <div>
                <dt class="text-[11px] text-muted">Reporting period</dt>
                <dd class="mt-1 text-[13px] font-medium text-ink">@Model.Report.ReportingPeriod</dd>
            </div>
            <div>
                <dt class="text-[11px] text-muted">Created by</dt>
                <dd class="mt-1 text-[13px] font-medium text-ink">@Model.Report.CreatedBy</dd>
            </div>
        </dl>
    </section>

    <section class="rounded-xl border border-[#c9dcf3] bg-sky-soft p-4" role="note">
        <p class="text-[12px] font-semibold text-ink">Illustrative demo report</p>
        <p class="mt-1 text-[11px] leading-relaxed text-muted">@Model.DataNote</p>
    </section>

    <section class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-xl border border-[#c9dcf3] bg-sky p-4">
            <p class="text-[12px] text-ink-2/80">Total Employees</p>
            <p class="mt-1.5 text-[24px] font-bold leading-none">@Model.TotalEmployees</p>
            <p class="mt-2 text-[10.5px] text-muted">In this report's available sample</p>
        </div>
        <div class="rounded-xl border border-[#cfe7da] bg-brand-soft/70 p-4">
            <p class="text-[12px] text-ink-2/80">Employees Assessed</p>
            <p class="mt-1.5 text-[24px] font-bold leading-none">@Model.EmployeesAssessed</p>
            <p class="mt-2 text-[10.5px] text-muted">With recorded skill levels</p>
        </div>
        <div class="rounded-xl border border-[#c9dcf3] bg-sky p-4">
            <p class="text-[12px] text-ink-2/80">Average Skill Proficiency</p>
            <p class="mt-1.5 text-[24px] font-bold leading-none">@Model.AverageSkillProficiencyPercent%</p>
            <p class="mt-2 text-[10.5px] text-muted">Across assessed skills (1–5 scale)</p>
        </div>
        <div class="rounded-xl border border-[#cfe7da] bg-brand-soft/70 p-4">
            <p class="text-[12px] text-ink-2/80">Training Completion Rate</p>
            <p class="mt-1.5 text-[24px] font-bold leading-none">@Model.TrainingCompletionPercent%</p>
            <p class="mt-2 text-[10.5px] text-muted">Average course completion</p>
        </div>
    </section>

    <section class="space-y-2">
        <div>
            <h2 class="section-title">Skill gap analysis</h2>
            <p class="mt-0.5 text-[11px] text-muted">Current proficiency compared with role requirements for the employees in this report.</p>
        </div>
        <div class="card overflow-hidden">
            <div class="overflow-x-auto">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Department</th>
                            <th>Skill</th>
                            <th>Current proficiency</th>
                            <th>Required proficiency</th>
                            <th>Identified gap</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.SkillProficiency.Count == 0)
                        {
                            <tr><td colspan="6" class="!py-6 text-center text-muted">No skill proficiency records are available.</td></tr>
                        }
                        @foreach (var skill in Model.SkillProficiency)
                        {
                            <tr>
                                <td class="whitespace-nowrap font-medium text-ink">@skill.Employee</td>
                                <td class="whitespace-nowrap text-muted">@skill.Department</td>
                                <td class="whitespace-nowrap text-ink-2">@skill.Skill</td>
                                <td>
                                    @if (skill.CurrentLevel.HasValue)
                                    {
                                        <div class="flex min-w-[110px] items-center gap-2">
                                            <span class="whitespace-nowrap text-ink-2">@skill.CurrentLevel / 5</span>
                                            <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-brand-soft">
                                                <div class="h-full rounded-full bg-brand" style="width:@(Math.Clamp(skill.CurrentLevel.Value * 20, 0, 100))%"></div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not assessed</span>
                                    }
                                </td>
                                <td class="whitespace-nowrap text-muted">@(skill.RequiredLevel.HasValue ? $"{skill.RequiredLevel.Value} / 5" : "—")</td>
                                <td>
                                    @if (skill.Gap.HasValue)
                                    {
                                        <span class="badge @(skill.Gap.Value > 0 ? "badge-amber" : "badge-green")">
                                            @(skill.Gap.Value > 0 ? $"{skill.Gap.Value} level{(skill.Gap.Value == 1 ? "" : "s")}" : "No gap")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-muted">Unknown</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card p-4">
            <h3 class="text-[13px] font-semibold text-ink">Skills requiring improvement</h3>
            @if (Model.IdentifiedSkillGaps.Count == 0)
            {
                <p class="mt-2 text-[11px] text-muted">No skill gaps are recorded in this report scope.</p>
            }
            else
            {
                <div class="mt-2 flex flex-wrap gap-2">
                    @foreach (var skill in Model.IdentifiedSkillGaps)
                    {
                        <span class="badge badge-amber">@skill.Employee · @skill.Skill (@skill.Gap level@(skill.Gap == 1 ? "" : "s"))</span>
                    }
                </div>
            }
        </div>
    </section>

    <section class="space-y-2">
        <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
                <h2 class="section-title">Training progress analysis</h2>
                <p class="mt-0.5 text-[11px] text-muted">Assigned programs and completion status from available learning plans.</p>
            </div>
            <p class="text-[20px] font-bold leading-none text-ink">@Model.TrainingCompletionPercent%</p>
        </div>
        <div class="card p-5">
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                <div>
                    <p class="text-[11px] text-muted">Assigned programs</p>
                    <p class="mt-1 text-[18px] font-semibold text-ink">@Model.TrainingPrograms.Count</p>
                </div>
                <div>
                    <p class="text-[11px] text-muted">Completed</p>
                    <p class="mt-1 text-[18px] font-semibold text-ink">@Model.CompletedTraining</p>
                </div>
                <div>
                    <p class="text-[11px] text-muted">In progress</p>
                    <p class="mt-1 text-[18px] font-semibold text-ink">@Model.InProgressTraining</p>
                </div>
                <div>
                    <p class="text-[11px] text-muted">Pending</p>
                    <p class="mt-1 text-[18px] font-semibold text-ink">@Model.PendingTraining</p>
                </div>
            </div>
            <div class="mt-3 h-2.5 overflow-hidden rounded-full bg-brand-soft" role="progressbar" aria-label="Overall training completion" aria-valuenow="@Model.TrainingCompletionPercent" aria-valuemin="0" aria-valuemax="100">
                <div class="h-full rounded-full bg-brand" style="width:@(Model.TrainingCompletionPercent)%"></div>
            </div>
        </div>
        <div class="card overflow-hidden">
            <div class="overflow-x-auto">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Training program</th>
                            <th>Skill category</th>
                            <th>Target date</th>
                            <th>Completion</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.TrainingPrograms.Count == 0)
                        {
                            <tr><td colspan="6" class="!py-6 text-center text-muted">No assigned training programs are available.</td></tr>
                        }
                        @foreach (var training in Model.TrainingPrograms)
                        {
                            var trainingBadge = training.Status switch
                            {
                                "Completed" => "badge-green",
                                "In Progress" => "badge-blue",
                                _ => "badge-muted"
                            };
                            <tr>
                                <td class="whitespace-nowrap font-medium text-ink">@training.Employee</td>
                                <td class="min-w-[190px] font-medium text-ink">@training.Course</td>
                                <td class="whitespace-nowrap text-muted">@training.SkillCategory</td>
                                <td class="whitespace-nowrap text-muted">@(string.IsNullOrWhiteSpace(training.TargetCompletionDate) ? "—" : training.TargetCompletionDate)</td>
                                <td>
                                    <div class="flex min-w-[105px] items-center gap-2">
                                        <span class="w-9 shrink-0 text-muted">@training.ProgressPercent%</span>
                                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-brand-soft">
                                            <div class="h-full rounded-full bg-brand" style="width:@(training.ProgressPercent)%"></div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge @trainingBadge">@training.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="space-y-2">
        <div>
            <h2 class="section-title">Employee performance overview</h2>
            <p class="mt-0.5 text-[11px] text-muted">Skill assessments, recorded results, and course progress for each employee.</p>
        </div>
        <div class="card overflow-hidden">
            <div class="overflow-x-auto">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Department</th>
                            <th>Skills assessed</th>
                            <th>Assessment results</th>
                            <th>Training progress</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Employees.Count == 0)
                        {
                            <tr><td colspan="6" class="!py-6 text-center text-muted">No employee records are available.</td></tr>
                        }
                        @foreach (var employee in Model.Employees)
                        {
                            var employeeTrainingBadge = employee.TrainingStatus switch
                            {
                                "Completed" => "badge-green",
                                "In progress" => "badge-blue",
                                "Not started" => "badge-muted",
                                _ => "badge-amber"
                            };
                            <tr>
                                <td class="whitespace-nowrap font-medium text-ink">@employee.Name</td>
                                <td class="whitespace-nowrap text-muted">@employee.Department</td>
                                <td class="whitespace-nowrap text-muted">@employee.SkillsAssessed</td>
                                <td class="min-w-[230px] text-muted">@employee.AssessmentResults</td>
                                <td class="min-w-[165px]">
                                    <div class="flex items-center justify-between gap-2">
                                        <span class="text-[11px] text-ink-2">@employee.TrainingProgressPercent%</span>
                                        <span class="badge @employeeTrainingBadge">@employee.TrainingStatus</span>
                                    </div>
                                    <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-brand-soft">
                                        <div class="h-full rounded-full bg-brand" style="width:@(employee.TrainingProgressPercent)%"></div>
                                    </div>
                                </td>
                                <td>
                                    <a href="@Url.Action("TrainingDetail", "Manager", new { name = employee.Name })" class="whitespace-nowrap text-[11.5px] font-medium text-brand-deep underline decoration-brand/40 underline-offset-2 hover:text-ink">View details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="space-y-2">
        <div>
            <h2 class="section-title">Report insights</h2>
            <p class="mt-0.5 text-[11px] text-muted">Insights are derived from the same illustrative records shown above.</p>
        </div>
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
            @foreach (var insight in Model.Insights)
            {
                <article class="card p-4">
                    <h3 class="text-[13px] font-semibold text-ink">@insight.Title</h3>
                    <p class="mt-1.5 text-[11.5px] leading-relaxed text-muted">@insight.Detail</p>
                </article>
            }
        </div>
    </section>

    <div>
        <a href="/manager/reports" class="btn btn-outline btn-sm">Back to Reports</a>
    </div>
</div>
