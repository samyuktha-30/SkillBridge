@model ManagerSettingsViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Settings";
}

<div class="manager-settings">
    <header class="settings-page-heading">
        <div>
            <h1>Settings</h1>
            <p>Manage your account preferences, notifications, privacy, and security.</p>
        </div>
        <span class="settings-shield" aria-hidden="true">
            <svg><use href="#i-shield-check" /></svg>
        </span>
    </header>

    @if (ViewData["SettingsNotice"] is string notice)
    {
        <p class="settings-notice" role="status">@notice</p>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="settings-validation" role="alert"></div>
    }

    <form asp-controller="Manager" asp-action="Settings" method="post" class="settings-form">
        @Html.AntiForgeryToken()

        <div class="settings-grid settings-grid-primary">
            <section class="settings-card">
                <h2>Account settings</h2>
                <dl class="settings-account-details">
                    <div><dt>Full name</dt><dd>@Model.FullName</dd></div>
                    <div><dt>Email address</dt><dd>@Model.EmailAddress</dd></div>
                    <div><dt>Employee ID</dt><dd>@Model.EmployeeId</dd></div>
                    <div><dt>Department</dt><dd>@Model.Department</dd></div>
                </dl>
                <a href="/manager/profile" class="settings-button settings-button-profile">Edit profile</a>
            </section>

            <section class="settings-card">
                <h2>Notification preferences</h2>
                <div class="settings-preference-list">
                    <div class="settings-row">
                        <span>Assessment results</span>
                        <label class="settings-toggle">
                            <input asp-for="AssessmentResults" class="settings-toggle-input" aria-label="Assessment results notifications" />
                            <span class="settings-toggle-state" aria-hidden="true"></span>
                        </label>
                    </div>
                    <div class="settings-row">
                        <span>Learning plan updates</span>
                        <label class="settings-toggle">
                            <input asp-for="LearningPlanUpdates" class="settings-toggle-input" aria-label="Learning plan update notifications" />
                            <span class="settings-toggle-state" aria-hidden="true"></span>
                        </label>
                    </div>
                    <div class="settings-row">
                        <span>Training deadline alerts</span>
                        <label class="settings-toggle">
                            <input asp-for="TrainingDeadlineAlerts" class="settings-toggle-input" aria-label="Training deadline alerts" />
                            <span class="settings-toggle-state" aria-hidden="true"></span>
                        </label>
                    </div>
                    <div class="settings-row">
                        <span>Monthly report delivery</span>
                        <label class="settings-toggle">
                            <input asp-for="MonthlyReportDelivery" class="settings-toggle-input" aria-label="Monthly report delivery" />
                            <span class="settings-toggle-state" aria-hidden="true"></span>
                        </label>
                    </div>
                    <div class="settings-row">
                        <span>System announcements</span>
                        <label class="settings-toggle">
                            <input asp-for="SystemAnnouncements" class="settings-toggle-input" aria-label="System announcements" />
                            <span class="settings-toggle-state" aria-hidden="true"></span>
                        </label>
                    </div>
                </div>
            </section>
        </div>

        <div class="settings-grid settings-grid-secondary">
            <section class="settings-card">
                <h2>Privacy &amp; security</h2>
                <div class="settings-preference-list">
                    <div class="settings-row">
                        <span>Password</span>
                        <a href="/forgot-password" class="settings-button settings-button-password">Change password</a>
                    </div>
                    <div class="settings-row">
                        <span>Two-factor authentication</span>
                        <label class="settings-toggle">
                            <input asp-for="TwoFactorAuthentication" class="settings-toggle-input" aria-label="Two-factor authentication" />
                            <span class="settings-toggle-state" aria-hidden="true"></span>
                        </label>
                    </div>
                    <div class="settings-row">
                        <span>Active sessions</span>
                        <button type="button" class="settings-button settings-button-sessions" data-modal-open="manager-sessions">View sessions</button>
                    </div>
                </div>
                <p class="settings-security-note">Review devices and strengthen account security.</p>
            </section>

            <section class="settings-card">
                <h2>Workspace preferences</h2>
                <div class="settings-preference-list">
                    <label class="settings-row" for="Theme">
                        <span>Theme</span>
                        <select asp-for="Theme" class="settings-select">
                            <option>Light</option>
                            <option>Dark</option>
                        </select>
                    </label>
                    <label class="settings-row" for="Language">
                        <span>Language</span>
                        <select asp-for="Language" class="settings-select">
                            <option>English</option>
                            <option>Hindi</option>
                        </select>
                    </label>
                    <label class="settings-row" for="TimeZone">
                        <span>Time zone</span>
                        <select asp-for="TimeZone" class="settings-select">
                            <option>IST (UTC +5:30)</option>
                            <option>UTC</option>
                        </select>
                    </label>
                    <label class="settings-row" for="DefaultTeamView">
                        <span>Default team view</span>
                        <select asp-for="DefaultTeamView" class="settings-select">
                            <option>All departments</option>
                            <option>Engineering</option>
                            <option>Operations</option>
                            <option>Data &amp; Insights</option>
                        </select>
                    </label>
                </div>
            </section>
        </div>

        <section class="settings-card settings-account-data">
            <div>
                <h2>Account data</h2>
                <p>Download a copy of your personal information and account preferences.</p>
                <p class="settings-account-data-note">Team data exports are available on the Reports page.</p>
            </div>
            <a href="/manager/settings/export" class="settings-button settings-button-download">Download my data</a>
        </section>

        <footer class="settings-actions">
            <p>Preferences apply to your manager account only. Changes are demo-only and are not persisted.</p>
            <div>
                <a href="/manager/settings" class="settings-button settings-button-cancel">Cancel</a>
                <button type="submit" class="settings-button settings-button-save">Save changes</button>
            </div>
        </footer>
    </form>
</div>

<div id="manager-sessions" class="fixed inset-0 z-50 hidden items-center justify-center bg-ink/40 p-4" data-modal>
    <section class="w-full max-w-md rounded-xl border border-line bg-white p-6 shadow-2xl" role="dialog" aria-modal="true" aria-labelledby="manager-sessions-title">
        <div class="flex items-start justify-between gap-4">
            <div>
                <h2 id="manager-sessions-title" class="text-[18px] font-bold text-ink">Active sessions</h2>
                <p class="mt-2 text-[13px] text-ink-2">This demo does not keep a session inventory. Only your current signed-in session is available.</p>
            </div>
            <button type="button" class="rounded-md p-1 text-muted hover:bg-cream" data-modal-close aria-label="Close">
                <svg class="h-4 w-4"><use href="#i-x" /></svg>
            </button>
        </div>
        <div class="mt-5 flex justify-end">
            <button type="button" class="settings-button settings-button-cancel" data-modal-close>Close</button>
        </div>
    </section>
</div>
