@model dynamic

@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Candidate Detail";
}

<div class="space-y-5">
    <!-- Header -->
    <section class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="page-title">Candidate Management</h1>
            <p class="mt-1 text-[13px] text-muted">Track candidate progress and manage team hiring.</p>
        </div>
        <img src="/img/mgr-hero.png" alt="" class="hidden h-[70px] w-auto select-none sm:block" draggable="false" />
    </section>

    <!-- Candidate List -->
    <section class="overflow-x-auto">
        <table class="min-w-full bg-white rounded-xl overflow-hidden">
            <thead>
                <tr class="bg-gray-50">
                    <th class="text-left text-[11px] font-medium text-ink-2 p-4">Candidate</th>
                    <th class="text-left text-[11px] font-medium text-ink-2 p-4">Role</th>
                    <th class="text-left text-[11px] font-medium text-ink-2 p-4">Department</th>
                    <th class="text-left text-[11px] font-medium text-ink-2 p-4">Stage</th>
                    <th class="text-left text-[11px] font-medium text-ink-2 p-4">Skill Score</th>
                    <th class="text-left text-[11px] font-medium text-ink-2 p-4">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var candidate in Model.candidates)
                {
                    <tr class="border-b">
                        <td class="whitespace-nowrap font-medium text-ink p-4">@candidate.name</td>
                        <td class="text-muted p-4">@candidate.role</td>
                        <td class="text-muted p-4">@candidate.department</td>
                        <td class="text-muted p-4">@candidate.stage</td>
                        <td class="text-muted p-4">@candidate.score</td>
                        <td class="p-4">
                            <a href="/manager/candidates" class="text-[11.5px] font-medium text-brand-decor underline decoration-brand/40 underline-offset-2 hover:text-ink">Review</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <!-- Stats & Actions -->
    <section class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
            <p class="text-[12px] text-muted">Active candidates</p>
            <p class="text-[20px] font-bold text-ink">6</p>
        </div>
        <div>
            <p class="text-[12px] text-muted">Hiring pipeline</p>
            <p class="text-[20px] font-bold text-ink">2</p>
        </div>
    </section>

    <!-- Filters -->
    <section class="mt-6 pt-6 border-t border-line-soft">
        <div class="flex flex-wrap items-center gap-3">
            <label class="relative">
                <span class="text-[10px] text-muted">Department</span>
                <select class="appearance-none rounded-md border border-line px-3 py-2 text-[10px]">
                    <option>All</option>
                    <option>Engineering</option>
                    <option>Marketing</option>
                    <option>Sales</option>
                </select>
            </label>
            <label class="relative">
                <span class="text-[10px] text-muted">Status</span>
                <select class="appearance-none rounded-md border border-line px-3 py-2 text-[10px]">
                    <option>All</option>
                    <option>Active</option>
                    <option>Interviewing</option>
                </select>
            </label>
            <button type="button" class="btn btn-outline px-4 py-2 text-[10px]">Add Candidate</button>
        </div>
    </section>
</div>
