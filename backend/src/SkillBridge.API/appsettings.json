{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=SkillBridgeDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "SkillBridge.API",
    "Audience": "SkillBridge.Frontend",
    "SecretKey": "REPLACE_WITH_MIN_32_CHAR_DEVELOPMENT_JWT_SECRET_KEY",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "AiService": {
    "BaseUrl": "http://localhost:8000",
    "InternalKey": "REPLACE_WITH_SHARED_INTERNAL_SERVICE_KEY"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Features": {
    "IncludeResetTokenPreview": false
  },
  "Seed": {
    "AdminEmail": "admin@skillbridge.ai",
    "AdminPassword": "",
    "ManagerEmail": "manager@skillbridge.ai",
    "ManagerPassword": "",
    "EmployeeEmail": "",
    "EmployeePassword": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
